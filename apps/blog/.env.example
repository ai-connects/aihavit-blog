# HAVIT Blog — 환경 변수 (Vercel Dashboard에서 설정)

# 사이트 URL
NEXT_PUBLIC_SITE_URL=https://blog.aihavit.com
NEXT_PUBLIC_MAIN_URL=https://aihavit.com

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Revalidate webhook (Django → Vercel)
REVALIDATE_SECRET=replace-with-random-strong-secret

# Twitter (선택)
TWITTER_HANDLE=@havit_ai

# Article 자동 생성 (서버사이드만 사용, 절대 NEXT_PUBLIC_ 접두사 금지)
ANTHROPIC_API_KEY=sk-ant-...
