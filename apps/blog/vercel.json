{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "regions": ["icn1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/ko", "permanent": true },
    { "source": "/blog", "destination": "/ko", "permanent": true },
    { "source": "/blog/seo-batch-1", "destination": "/ko", "permanent": true },
    { "source": "/blog/seo-batch-2", "destination": "/ko", "permanent": true },
    { "source": "/blog/sample", "destination": "/ko", "permanent": true },
    { "source": "/blog/seo-sample", "destination": "/ko", "permanent": true },
    { "source": "/blog/g", "destination": "/ko", "permanent": true },
    { "source": "/blog/seo-batch-2/:slug", "destination": "/ko/:slug", "permanent": true },
    { "source": "/blog/g/:slug", "destination": "/ko/:slug", "permanent": true },
    { "source": "/blog/:lang/search", "destination": "/:lang", "permanent": true },
    { "source": "/blog/:lang/c/:catSlug", "destination": "/:lang", "permanent": true },
    { "source": "/blog/:lang/:slug", "destination": "/:lang/:slug", "permanent": true }
  ]
}
